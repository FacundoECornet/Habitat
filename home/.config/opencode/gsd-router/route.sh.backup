#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-}"

if [[ "$PROFILE" != "easy" && "$PROFILE" != "medium" && "$PROFILE" != "hard" ]]; then
  echo "Uso: gsd-route {easy|medium|hard}"
  exit 1
fi

PROFILE_FILE="$HOME/.config/opencode/gsd-router/${PROFILE}.json"
DEFAULTS="$HOME/.gsd/defaults.json"

python3 - "$PROFILE_FILE" "$DEFAULTS" <<'PY'
import json
import sys
from pathlib import Path

profile_file = Path(sys.argv[1])
defaults_file = Path(sys.argv[2])

profile = json.loads(profile_file.read_text())

if defaults_file.exists():
    defaults = json.loads(defaults_file.read_text())
else:
    defaults = {}

defaults["resolve_model_ids"] = "omit"
defaults["model_overrides"] = profile["model_overrides"]

defaults_file.write_text(
    json.dumps(defaults, indent=2) + "\n"
)

print(f"Ruta GSD activa: {profile['name']}")
for agent, model in profile["model_overrides"].items():
    print(f"  {agent}: {model}")
PY

{
  // Única fuente de verdad de la config de opencode del hábitat.
  // Antes vivía partida entre opencode.json (plugins) y opencode.jsonc
  // (agentes + MCP); quedó fusionada acá.
  "$schema": "https://opencode.ai/config.json",

  // Plugins locales + paquetes npm. La ruta es relativa a este archivo, por eso
  // el prefijo "./" (nunca una ruta absoluta de la PC de origen).
  //
  // "context-mode" es el plugin nativo: sirve para la línea 1.x de opencode.
  // En la línea 2.x un plugin 1.x no carga (el host solo acepta un default
  // export con id + setup), así que el instalador lo quita de acá y declara el
  // servidor MCP de context-mode en el bloque "mcp" de más abajo: las
  // herramientas ctx_* siguen disponibles, por la misma vía que usa el plugin.
  "plugin": [
    "./plugins/caveman/plugin.js",
    "./plugins/graphify.js",
    "context-mode"
  ],

  "agent": {
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-discuss-phase": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-planner": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-architect": {
      "model": "opencode-go/mimo-v2.6-pro"
    },

    "gsd-researcher": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-phase-researcher": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-plan-checker": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-pattern-mapper": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-discovery": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-executor": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    "gsd-reviewer": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-checker": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-verifier": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-gap-closure": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    "gsd-retrospective": {
      "model": "opencode/muse-spark-1.3"
    },

    "gsd-documenter": {
      "model": "opencode/muse-spark-1.3"
    },

    "gsd-commit": {
      "model": "opencode/muse-spark-1.3"
    }
  },

  "mcp": {
    "jev": {
      "type": "local",
      "command": ["habitat-jev-mcp"],
      "timeout": 10000
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-discuss-phase": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-planner": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-architect": {
      "model": "opencode-go/mimo-v2.6-pro"
    },

    "gsd-researcher": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-phase-researcher": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-plan-checker": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-pattern-mapper": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-discovery": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-executor": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    "gsd-reviewer": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-checker": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-verifier": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-gap-closure": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    "gsd-retrospective": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },

    "gsd-documenter": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },

    "gsd-commit": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    }
  },
  
  "mcp": {
    "jev": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@jkudish/jev-mcp"
      ],
      "environment": {
        // Primario: OpenCode Zen (gratis, probado) como endpoint System One compatible.
        // Requiere JEV_API_KEY en el entorno (normalmente OPENCODE_API_KEY).
        "JEV_PROVIDER": "compatible",
        "JEV_API_BASE_URL": "https://opencode.ai/inference/systemone/v1/systemone",
        "JEV_API_KEY": "{env:JEV_API_KEY}",
        "JEV_MCP_MODEL": "jev-1.13-free"
        // Fallback validado — volver a TypeSafe:
        //   "JEV_PROVIDER": "typesafe",
        //   "TYPESAFE_API_KEY": "{env:TYPESAFE_API_KEY}"
        // El router tools/gsd-jevs-route.mjs prueba zen_free -> typesafe -> user
        // por su cuenta y no depende de esta entrada MCP.
      }
    }
  }
}

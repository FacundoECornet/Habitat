{
  // Única fuente de verdad de la config de opencode del hábitat.
  // Antes vivía partida entre opencode.json (plugins) y opencode.jsonc
  // (agentes + MCP); quedó fusionada acá.
  "$schema": "https://opencode.ai/config.json",

  // Plugins locales + paquetes npm. La ruta es relativa a este archivo, por eso
  // el prefijo "./" (nunca una ruta absoluta de la PC de origen).
  //
  // "context-mode" es el plugin nativo (línea 1.x de opencode). El puente
  // "./plugins/context-mode-bridge.js" cubre la línea 2.x: allí el plugin
  // nativo no carga, y el puente registra el servidor MCP de context-mode para
  // que las herramientas ctx_* sigan disponibles.
  "plugin": [
    "./plugins/caveman/plugin.js",
    "./plugins/graphify.js",
    "context-mode",
    "./plugins/context-mode-bridge.js"
  ],

  "agent": {
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-discuss-phase": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-planner": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-architect": {
      "model": "opencode-go/mimo-v2.6-pro"
    },

    "gsd-researcher": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-phase-researcher": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-plan-checker": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-pattern-mapper": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-discovery": {
      "model": "opencode/mimo-v2.6-flash-free"
    },

    "gsd-executor": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    "gsd-reviewer": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-checker": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-verifier": {
      "model": "opencode-go/gpt-6-luna"
    },

    "gsd-gap-closure": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    "gsd-retrospective": {
      "model": "opencode/muse-spark-1.3"
    },

    "gsd-documenter": {
      "model": "opencode/muse-spark-1.3"
    },

    "gsd-commit": {
      "model": "opencode/muse-spark-1.3"
    }
  },

  "mcp": {
    "jev": {
      "type": "local",
      "command": ["habitat-jev-mcp"],
      "timeout": 10000
    }
  }
}

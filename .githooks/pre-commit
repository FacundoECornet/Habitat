#!/usr/bin/env bash
# pre-commit — fail-closed staged-secret gate for ordinary commits
#
# What it does:
#   Scans the STAGED INDEX blobs (not the working tree) for five secret-signature
#   classes. On any match it aborts the ordinary `git commit` and reports only the
#   violated rule name, the staged path, and the line number. It never prints the
#   matched bytes.
#
# Fail-closed policy:
#   grep status 0 means a match (block); status 1 alone means clean; any other
#   status, a Git error, or an unreadable blob blocks with a named scan-failed
#   reason. Staged paths are enumerated NUL-delimited (`--diff-filter=d -z`) so
#   every non-deletion status — including typechange — and every unusual
#   (non-ASCII) filename reaches the scanner. Enumeration and index-blob read
#   errors block instead of producing a clean scan.
#
# Detector policy:
#   The five secret-signature rules are defined once in lib/secret-scan.sh
#   (fragment-built) and sourced here, so this gate and capture's scans cannot
#   drift. Prefix-style token rules require a plausible token-body
#   length and the private-key rule is anchored to real PEM header structure, so
#   ordinary hyphenated prose and documentation quoting a bare marker do not
#   match.
#
# Bypass limitation:
#   `git commit --no-verify` bypasses this hook by design (native Git behavior).
#   This hook is a normal-workflow backstop, NOT a security boundary against
#   deliberate bypass. The installer never claims otherwise.
#
# NOTE: `set -e` is deliberately omitted — grep exit statuses are handled
# explicitly. Only `set -u` and `set -o pipefail` are enabled.

set -u
set -o pipefail

# --- load the shared fragment-built secret detector -------------------------
# The five rules live in one library so this gate and capture's scans can never
# drift. The library assembles every signature from fragments, so neither this
# hook nor the library self-matches when its own source is staged.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! . "$HOOK_DIR/../lib/secret-scan.sh"; then
  printf 'BLOCKED: scan-failed (cannot load shared secret detector lib/secret-scan.sh)\n' >&2
  exit 1
fi

# --- reporting via the shared library (rule + path + line; never bytes) ------
blocked=0

scan_path() {
  local path="$1" content
  if ! content="$(git show ":$path" 2>/dev/null)"; then
    secret_report 'scan-failed' "$path" '?'
    blocked=1
    return
  fi

  secret_scan_content "$path" "$content"
  [ "$SECRET_SCAN_BLOCKED" -eq 1 ] && blocked=1
}

# --- enumerate staged paths (fail closed on any Git enumeration error) ------
# Enumerate into a temporary file with NUL separation: Bash variables cannot
# hold NUL bytes, and `--diff-filter=d -z` retains every non-deletion status
# (including typechange `T`) as well as unusual/non-ASCII names verbatim.
# Capture the Git status before scanning: a Git failure here must block with a
# named reason instead of letting an empty list produce a clean scan (CR-01).
staged_list="$(mktemp)" || {
  printf 'BLOCKED: scan-failed (cannot create staged-path enumeration list)\n' >&2
  exit 1
}
trap 'rm -f "$staged_list"' EXIT

if ! git diff --cached --name-only --diff-filter=d -z > "$staged_list"; then
  printf 'BLOCKED: scan-failed (Git staged-path enumeration failed)\n' >&2
  exit 1
fi

# --- scan every staged blob that will enter the commit ---------------------
while IFS= read -r -d '' staged; do
  [ -n "$staged" ] || continue
  scan_path "$staged"
done < "$staged_list"

if [ "$blocked" -ne 0 ]; then
  printf 'pre-commit: commit blocked by the secret gate. Bypass: git commit --no-verify.\n' >&2
  exit 1
fi
exit 0

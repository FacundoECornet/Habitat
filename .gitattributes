# .gitattributes — Habitat: el tooling asume LF (anclas de parche, bash, checksums).
# F-10: sin estos pins, un checkout Windows (core.autocrlf=true) deja CRLF y
# rompe extractAnchors de install.mjs + todos los .sh. Alcance mínimo: solo
# archivos funcionales; el resto del payload documental queda con el default.

# Scripts shell (bash muere con CRLF)
*.sh text eol=lf
.githooks/* text eol=lf

# TSV del allowlist: claves exactas, un \r colgado rompe todos los match
scripts/*.tsv text eol=lf

# Herramientas y suites node
*.mjs text eol=lf

# Manifiestos y config funcional (JSON.parse tolera CRLF, pero LF evita ruido)
MANIFEST.json text eol=lf
home/.config/opencode/gsd-router/*.json text eol=lf
home/.config/opencode/opencode.jsonc text eol=lf
home/.config/opencode/gsd-file-manifest.json text eol=lf

# Archivos parcheados por install.mjs (anclas checksum-verificadas)
home/.config/opencode/get-shit-done/workflows/new-project.md text eol=lf
home/.config/opencode/get-shit-done/workflows/execute-phase.md text eol=lf
home/.config/opencode/get-shit-done/references/model-profile-resolution.md text eol=lf
home/.config/opencode/get-shit-done/command/gsd-graphify.md text eol=lf
home/.config/opencode/get-shit-done/command/gsd-import.md text eol=lf

# Dotfiles restaurados que bash consume
home/.bashrc text eol=lf
home/.gitconfig text eol=lf

# Keep maintainer planning and inventory out of `git archive` release bundles.
# These files remain visible to repository collaborators on GitHub.
.planning/** export-ignore
graphify-out/** export-ignore
INVENTORY.md export-ignore
docs/OVERVIEW.md export-ignore
tests/** export-ignore

# Preserve Archify-delivered HTML bytes; generated whitespace is part of its receipt.
.archify/**/*.html whitespace=-blank-at-eol
